{
  "name": "morari-translate-desktop",
  "version": "1.0.0",
  "description": "Desktop control app for the morari-translate live katha captioning worker",
  "author": "Morari Translate",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "generate-assets": "node scripts/generate-assets.js",
    "build:renderer": "node scripts/build-renderer.js",
    "watch:renderer": "node scripts/build-renderer.js --watch",
    "start": "npm run build:renderer && electron .",
    "dev": "npm run build:renderer && electron . --dev",
    "test": "node scripts/test/run-all.js",
    "build": "npm run build:renderer && electron-builder",
    "build:mac": "npm run build:renderer && electron-builder --mac",
    "build:win": "npm run build:renderer && electron-builder --win",
    "build:all": "npm run build:renderer && electron-builder -mw"
  },
  "dependencies": {
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "electron": "^32.2.7",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.33.5"
  }
}
