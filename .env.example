# Morari Translate — worker configuration TEMPLATE
# ---------------------------------------------------------------------------
# The desktop app writes the REAL config to {userData}/worker.env via the
# Settings screen — you do NOT need to create this file by hand. It is provided
# only as a reference for every variable the worker reads.
#
#   macOS   : ~/Library/Application Support/morari-translate-desktop/worker.env
#   Windows : %APPDATA%\morari-translate-desktop\worker.env
#   Linux   : ~/.config/morari-translate-desktop/worker.env

# --- Worker Location (app-only; NOT passed to the worker) ---
WORKER_PATH=/absolute/path/to/morari-translate/worker

# --- Supabase ---
SUPABASE_URL=https://haysrsrrqowqucfqdalq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Session (also settable on the Setup screen) ---
SESSION_CODE=GSJZ76

# --- Sarvam STT ---
STT_PROVIDER=sarvam
SARVAM_API_KEY=
SARVAM_MODEL=saaras:v3
SARVAM_LANGUAGE_CODE=hi-IN

# --- OpenRouter Translation ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_MODEL=google/gemini-2.5-flash
TRANSLATOR_MODE=context

# --- Features ---
LOCKED_WORK_MODE=on
SOURCE_CONTEXT_WINDOW_MS=60000
CANONICAL_MATCH_MIN_TRIGGER_LEN=8

# --- Emergency Fallback (optional) ---
# If OpenRouter is unavailable, point the TRANSLATION_* fields at a fallback:
# OPENAI_BASE_URL=https://api.quatarly.cloud/v1
# OPENAI_API_KEY=qua-sub-...
# DEFAULT_MODEL=gemini-3-flash
